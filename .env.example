# ==============================================================
# Gym Tracker Project - Backend Environment Configuration
# ==============================================================

# Server Port (default 3000)
PORT=3000

# Google Gemini API Key (Recommended - fast, high vision accuracy, free tier available)
# Get a key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Optional: OpenAI API Key (if you prefer using OpenAI gpt-4o-mini vision)
# OPENAI_API_KEY=
# OPENAI_VISION_MODEL=gpt-4o-mini
